generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum StaffKind {
  BARBER
  RECEPTIONIST
  MANAGER
}

enum ScheduleBlockKind {
  VACATION
  DAY_OFF
  BREAK
  BLOCK
}

enum BookingStatus {
  HOLD
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELED
  NO_SHOW
}

enum BookingSource {
  PANEL
  PUBLIC
  WHATSAPP
}

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  BLOCKED
  CANCELED
}

model Plan {
  id                      String   @id @default(uuid(7)) @db.Uuid
  code                    String   @unique
  name                    String
  setupFeeCents           Int      @map("setup_fee_cents")
  monthlyPriceCents       Int      @map("monthly_price_cents")
  extraUnitPriceCents     Int      @default(0) @map("extra_unit_price_cents")
  extraUnitSetupFeeCents  Int      @default(0) @map("extra_unit_setup_fee_cents")
  maxUnits                Int?     @map("max_units")
  maxBarbers              Int?     @map("max_barbers")
  maxReceptionists        Int?     @map("max_receptionists")
  aiConversationsPerMonth Int      @default(0) @map("ai_conversations_per_month")
  features                String[] @default([])
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenants Tenant[]

  @@map("plans")
}

model Tenant {
  id               String       @id @default(uuid(7)) @db.Uuid
  slug             String       @unique @db.Citext
  legalName        String       @map("legal_name")
  displayName      String       @map("display_name")
  document         String?
  email            String       @db.Citext
  phone            String?
  timezone         String       @default("America/Sao_Paulo")
  status           TenantStatus @default(TRIAL)
  planId           String       @map("plan_id") @db.Uuid
  trialEndsAt      DateTime?    @map("trial_ends_at") @db.Timestamptz(6)
  featureOverrides Json?        @map("feature_overrides")
  limitOverrides   Json?        @map("limit_overrides")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(6)

  plan              Plan              @relation(fields: [planId], references: [id])
  branding          TenantBranding?
  units             Unit[]
  roles             Role[]
  memberships       Membership[]
  auditLogs         AuditLog[]
  invitations       Invitation[]
  staff             Staff[]
  services          Service[]
  serviceCategories ServiceCategory[]
  customers         Customer[]
  bookings          Booking[]

  @@index([status])
  @@map("tenants")
}

model TenantBranding {
  tenantId         String   @id @map("tenant_id") @db.Uuid
  logoUrl          String?  @map("logo_url")
  logoDarkUrl      String?  @map("logo_dark_url")
  iconUrl          String?  @map("icon_url")
  primaryColor     String   @default("#D62839") @map("primary_color")
  secondaryColor   String   @default("#1E4FD8") @map("secondary_color")
  allowOwnerRename Boolean  @default(false) @map("allow_owner_rename")
  customDomain     String?  @unique @map("custom_domain") @db.Citext
  showPoweredBy    Boolean  @default(true) @map("show_powered_by")
  emailSenderName  String?  @map("email_sender_name")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_brandings")
}

model Unit {
  id                  String    @id @default(uuid(7)) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  name                String
  slug                String    @db.Citext
  phone               String?
  street              String?
  number              String?
  district            String?
  city                String?
  state               String?   @db.Char(2)
  zipCode             String?   @map("zip_code")
  timezone            String    @default("America/Sao_Paulo")
  slotIntervalMinutes Int       @default(15) @map("slot_interval_minutes")
  minAdvanceMinutes   Int       @default(30) @map("min_advance_minutes")
  maxAdvanceDays      Int       @default(30) @map("max_advance_days")
  noShowAfterMinutes  Int       @default(30) @map("no_show_after_minutes")
  holdMinutes         Int       @default(5) @map("hold_minutes")
  checkInOpensMinutes Int       @default(60) @map("check_in_opens_minutes")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships  MembershipUnit[]
  staff        StaffUnit[]
  workingHours WorkingHours[]
  bookings     Booking[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("units")
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique @db.Citext
  name            String
  passwordHash    String    @map("password_hash")
  phone           String?
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  totpSecret      String?   @map("totp_secret")
  totpEnabledAt   DateTime? @map("totp_enabled_at") @db.Timestamptz(6)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  memberships   Membership[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String
  name        String
  isSystem    Boolean  @default(false) @map("is_system")
  permissions String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]
  invitations Invitation[]

  @@unique([tenantId, key])
  @@map("roles")
}

model Membership {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role             @relation(fields: [roleId], references: [id])
  units  MembershipUnit[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

model MembershipUnit {
  membershipId String @map("membership_id") @db.Uuid
  unitId       String @map("unit_id") @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  unit       Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([membershipId, unitId])
  @@index([tenantId])
  @@map("membership_units")
}

model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entity      String
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tenantId     String?   @map("tenant_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  ip           String?
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Invitation {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  email       String    @db.Citext
  name        String?
  tokenHash   String    @unique @map("token_hash")
  invitedById String?   @map("invited_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("invitations")
}

model Staff {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  kind      StaffKind @default(BARBER)
  name      String
  nickname  String?
  phone     String?
  email     String?   @db.Citext
  photoUrl  String?   @map("photo_url")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  units        StaffUnit[]
  workingHours WorkingHours[]
  blocks       ScheduleBlock[]
  services     StaffService[]
  bookings     Booking[]

  @@index([tenantId])
  @@map("staff")
}

model StaffUnit {
  staffId  String @map("staff_id") @db.Uuid
  unitId   String @map("unit_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  unit  Unit  @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([staffId, unitId])
  @@index([tenantId])
  @@map("staff_units")
}

model WorkingHours {
  id          String @id @default(uuid(7)) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  staffId     String @map("staff_id") @db.Uuid
  unitId      String @map("unit_id") @db.Uuid
  weekday     Int
  startMinute Int    @map("start_minute")
  endMinute   Int    @map("end_minute")

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  unit  Unit  @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([staffId, weekday])
  @@map("working_hours")
}

model ScheduleBlock {
  id        String            @id @default(uuid(7)) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  staffId   String            @map("staff_id") @db.Uuid
  kind      ScheduleBlockKind @default(BLOCK)
  startsAt  DateTime          @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime          @map("ends_at") @db.Timestamptz(6)
  reason    String?
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([staffId, startsAt])
  @@map("schedule_blocks")
}

model ServiceCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services Service[]

  @@unique([tenantId, name])
  @@map("service_categories")
}

model Service {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  categoryId      String?   @map("category_id") @db.Uuid
  name            String
  description     String?
  priceCents      Int       @map("price_cents")
  durationMinutes Int       @map("duration_minutes")
  bufferMinutes   Int       @default(0) @map("buffer_minutes")
  position        Int       @default(0)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  staff        StaffService[]
  bookingItems BookingItem[]

  @@index([tenantId])
  @@map("services")
}

model StaffService {
  staffId         String @map("staff_id") @db.Uuid
  serviceId       String @map("service_id") @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  priceCents      Int?   @map("price_cents")
  durationMinutes Int?   @map("duration_minutes")

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([tenantId])
  @@map("staff_services")
}

model Customer {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  name           String
  phone          String
  email          String?   @db.Citext
  birthDate      DateTime? @map("birth_date") @db.Date
  notes          String?
  tags           String[]  @default([])
  marketingOptIn Boolean   @default(true) @map("marketing_opt_in")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([tenantId, phone])
  @@index([tenantId, name])
  @@map("customers")
}

model Booking {
  id              String        @id @default(uuid(7)) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  unitId          String        @map("unit_id") @db.Uuid
  staffId         String        @map("staff_id") @db.Uuid
  customerId      String?       @map("customer_id") @db.Uuid
  status          BookingStatus @default(HOLD)
  source          BookingSource @default(PANEL)
  startsAt        DateTime      @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime      @map("ends_at") @db.Timestamptz(6)
  blockedUntil    DateTime      @map("blocked_until") @db.Timestamptz(6)
  holdExpiresAt   DateTime?     @map("hold_expires_at") @db.Timestamptz(6)
  totalPriceCents Int           @map("total_price_cents")
  notes           String?
  checkedInAt     DateTime?     @map("checked_in_at") @db.Timestamptz(6)
  completedAt     DateTime?     @map("completed_at") @db.Timestamptz(6)
  canceledAt      DateTime?     @map("canceled_at") @db.Timestamptz(6)
  cancelReason    String?       @map("cancel_reason")
  createdById     String?       @map("created_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit     Unit          @relation(fields: [unitId], references: [id])
  staff    Staff         @relation(fields: [staffId], references: [id])
  customer Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    BookingItem[]
  events   BookingEvent[]

  @@index([tenantId, startsAt])
  @@index([staffId, startsAt])
  @@index([customerId])
  @@map("bookings")
}

model BookingItem {
  id              String @id @default(uuid(7)) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  bookingId       String @map("booking_id") @db.Uuid
  serviceId       String @map("service_id") @db.Uuid
  name            String
  priceCents      Int    @map("price_cents")
  durationMinutes Int    @map("duration_minutes")
  position        Int    @default(0)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@index([bookingId])
  @@index([tenantId])
  @@map("booking_items")
}

model BookingEvent {
  id          String         @id @default(uuid(7)) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  bookingId   String         @map("booking_id") @db.Uuid
  fromStatus  BookingStatus? @map("from_status")
  toStatus    BookingStatus  @map("to_status")
  actorUserId String?        @map("actor_user_id") @db.Uuid
  reason      String?
  data        Json?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@index([tenantId])
  @@map("booking_events")
}

model IdempotencyKey {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String
  scope       String
  requestHash String   @map("request_hash")
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}
